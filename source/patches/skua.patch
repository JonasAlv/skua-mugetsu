+        "KeyD" | "D" => PK::KeyD,
+        "KeyE" | "E" => PK::KeyE,
+        "KeyF" | "F" => PK::KeyF,
+        "KeyG" | "G" => PK::KeyG,
+        "KeyH" | "H" => PK::KeyH,
+        "KeyI" | "I" => PK::KeyI,
+        "KeyJ" | "J" => PK::KeyJ,
+        "KeyK" | "K" => PK::KeyK,
+        "KeyL" | "L" => PK::KeyL,
+        "KeyM" | "M" => PK::KeyM,
+        "KeyN" | "N" => PK::KeyN,
+        "KeyO" | "O" => PK::KeyO,
+        "KeyP" | "P" => PK::KeyP,
+        "KeyQ" | "Q" => PK::KeyQ,
+        "KeyR" | "R" => PK::KeyR,
+        "KeyS" | "S" => PK::KeyS,
+        "KeyT" | "T" => PK::KeyT,
+        "KeyU" | "U" => PK::KeyU,
+        "KeyV" | "V" => PK::KeyV,
+        "KeyW" | "W" => PK::KeyW,
+        "KeyX" | "X" => PK::KeyX,
+        "KeyY" | "Y" => PK::KeyY,
+        "KeyZ" | "Z" => PK::KeyZ,
+        "Digit0" | "D0" => PK::Digit0,
+        "Digit1" | "D1" => PK::Digit1,
+        "Digit2" | "D2" => PK::Digit2,
+        "Digit3" | "D3" => PK::Digit3,
+        "Digit4" | "D4" => PK::Digit4,
+        "Digit5" | "D5" => PK::Digit5,
+        "Digit6" | "D6" => PK::Digit6,
+        "Digit7" | "D7" => PK::Digit7,
+        "Digit8" | "D8" => PK::Digit8,
+        "Digit9" | "D9" => PK::Digit9,
+        "Enter" | "Return" => PK::Enter,
+        "Escape" => PK::Escape,
+        "Backspace" | "Back" => PK::Backspace,
+        "Tab" => PK::Tab,
+        "Space" => PK::Space,
+        "ArrowLeft" | "Left" => PK::ArrowLeft,
+        "ArrowRight" | "Right" => PK::ArrowRight,
+        "ArrowUp" | "Up" => PK::ArrowUp,
+        "ArrowDown" | "Down" => PK::ArrowDown,
+        "ShiftLeft" | "LeftShift" => PK::ShiftLeft,
+        "ShiftRight" | "RightShift" => PK::ShiftRight,
+        "ControlLeft" | "LeftCtrl" => PK::ControlLeft,
+        "ControlRight" | "RightCtrl" => PK::ControlRight,
+        "AltLeft" | "LeftAlt" => PK::AltLeft,
+        "AltRight" | "RightAlt" => PK::AltRight,
+        "Delete" => PK::Delete,
+        "Home" => PK::Home,
+        "End" => PK::End,
+        "PageUp" => PK::PageUp,
+        "PageDown" => PK::PageDown,
+        _ => PK::Unknown,
+    }
+}
