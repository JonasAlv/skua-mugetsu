+fn skua_logical_key(key: &str) -> ruffle_core::events::LogicalKey {
+    use ruffle_core::events::{LogicalKey as LK, NamedKey as NK};
+    match key {
+        "Enter" | "Return" => LK::Named(NK::Enter),
+        "Escape" => LK::Named(NK::Escape),
+        "Backspace" | "Back" => LK::Named(NK::Backspace),
+        "Tab" => LK::Named(NK::Tab),
+        "Space" | " " => LK::Character(' '),
+        "ArrowLeft" | "Left" => LK::Named(NK::ArrowLeft),
+        "ArrowRight" | "Right" => LK::Named(NK::ArrowRight),
+        "ArrowUp" | "Up" => LK::Named(NK::ArrowUp),
+        "ArrowDown" | "Down" => LK::Named(NK::ArrowDown),
+        "Shift" => LK::Named(NK::Shift),
+        "Control" => LK::Named(NK::Control),
