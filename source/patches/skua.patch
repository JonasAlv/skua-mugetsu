+    /// Skua build: runs the calls Bonxie sent (see `skua.rs`).
+    fn run_skua_calls(&mut self) {
+        let calls = crate::skua::take_calls();
+        if calls.is_empty() {
+            return;
+        }
+        let mut player = self.player.get();
+        for call in calls {
+            let result = match player.as_mut() {
+                Some(player) => player.call_internal_interface(&call.name, call.args),
+                None => ruffle_core::external::Value::Null,
+            };
+            crate::skua::reply(call.id, result);
+        }
+    }
+
+    /// Skua build: runs forwarded input events from Bonxie in `--skua-shm` mode.
+    fn run_skua_inputs(&mut self, event_loop: &ActiveEventLoop) {
+        use crate::skua::SkuaInput;
+        use ruffle_core::events::{KeyDescriptor, TextControlCode};
+        use winit::dpi::PhysicalPosition;
+        use winit::event::{ElementState, MouseButton, MouseScrollDelta, TouchPhase};
+
+        let inputs = crate::skua::take_inputs();
+        if inputs.is_empty() {
+            return;
+        }
+        for input in inputs {
+            match input {
+                SkuaInput::Resize { width, height } => {
+                    self.window_event(
+                        event_loop,
+                        WindowEvent::Resized(winit::dpi::PhysicalSize::new(width, height)),
+                    );
+                }
+                SkuaInput::MouseMove { x, y } => {
+                    self.window_event(
+                        event_loop,
+                        WindowEvent::CursorMoved {
+                            device_id: winit::event::DeviceId::dummy(),
+                            position: PhysicalPosition::new(x, y),
+                        },
+                    );
+                }
+                SkuaInput::MouseButton { button, down } => {
+                    let button = match button.as_str() {
+                        "right" => MouseButton::Right,
+                        "middle" => MouseButton::Middle,
+                        _ => MouseButton::Left,
+                    };
+                    let state = if down {
+                        ElementState::Pressed
+                    } else {
+                        ElementState::Released
+                    };
+                    self.window_event(
+                        event_loop,
+                        WindowEvent::MouseInput {
+                            device_id: winit::event::DeviceId::dummy(),
+                            state,
+                            button,
+                        },
+                    );
+                }
+                SkuaInput::MouseWheel { dx, dy } => {
+                    self.window_event(
+                        event_loop,
+                        WindowEvent::MouseWheel {
+                            device_id: winit::event::DeviceId::dummy(),
+                            delta: MouseScrollDelta::PixelDelta(PhysicalPosition::new(dx, dy)),
+                            phase: TouchPhase::Moved,
+                        },
+                    );
+                }
+                SkuaInput::Focus { focused } => {
+                    self.window_event(event_loop, WindowEvent::Focused(focused));
+                }
+                SkuaInput::Visible { visible } => {
+                    let was_occluded = self.occluded;
+                    self.occluded = !visible;
+                    if visible && was_occluded {
+                        self.frame_since_render = true;
+                        self.gui.request_redraw();
+                    }
+                }
+                SkuaInput::Text { text } => {
+                    for codepoint in text.chars() {
+                        self.player
+                            .handle_event(PlayerEvent::TextInput { codepoint });
+                    }
+                    self.check_redraw();
+                }
+                SkuaInput::Key {
+                    down,
+                    code,
+                    key,
+                    ctrl,
+                    shift,
+                    alt: _,
+                } => {
+                    let desc = KeyDescriptor {
+                        physical_key: skua_physical_key(&code),
+                        logical_key: skua_logical_key(&key),
+                        key_location: ruffle_core::events::KeyLocation::Standard,
+                    };
+                    if down {
+                        self.player.handle_event(PlayerEvent::KeyDown { key: desc });
+                        let tc = match (key.as_str(), ctrl, shift) {
+                            ("a" | "A", true, false) => Some(TextControlCode::SelectAll),
+                            ("c" | "C", true, false) => Some(TextControlCode::Copy),
+                            ("v" | "V", true, false) => Some(TextControlCode::Paste),
+                            ("x" | "X", true, false) => Some(TextControlCode::Cut),
+                            ("Enter" | "Return", false, false) => Some(TextControlCode::Enter),
+                            ("Backspace" | "Back", true, _) => Some(TextControlCode::BackspaceWord),
+                            ("Backspace" | "Back", false, _) => Some(TextControlCode::Backspace),
+                            ("Delete", true, _) => Some(TextControlCode::DeleteWord),
+                            ("Delete", false, _) => Some(TextControlCode::Delete),
+                            ("ArrowLeft" | "Left", true, true) => {
+                                Some(TextControlCode::SelectLeftWord)
+                            }
+                            ("ArrowLeft" | "Left", true, false) => {
+                                Some(TextControlCode::MoveLeftWord)
+                            }
+                            ("ArrowLeft" | "Left", false, true) => Some(TextControlCode::SelectLeft),
+                            ("ArrowLeft" | "Left", false, false) => Some(TextControlCode::MoveLeft),
+                            ("ArrowRight" | "Right", true, true) => {
+                                Some(TextControlCode::SelectRightWord)
