new file mode 100644
index 00000000..b09aae15
--- /dev/null
+++ b/desktop/src/skua.rs
@@ -0,0 +1,426 @@
+//! Skua build: lets Bonxie drive the game and show it inside its own window.
+//!
+//! With `--skua-bridge host:port` the player connects to Bonxie over TCP and both sides send one
+//! JSON object per line:
+//!
+//! - Bonxie -> player: `{"id":1,"name":"isLoggedIn","args":[]}` calls an `ExternalInterface`
+//!   callback of the movie, answered with `{"id":1,"r":...}`.
+//! - Bonxie -> player: `{"input":"mouse_move","x":100,"y":200}` (and `resize`, `mouse_btn`,
+//!   `mouse_wheel`, `key`, `text`, `focus`, `clear_keys`) forwards input in `--skua-shm` mode.
+//! - player -> Bonxie: `{"ev":"loaded","args":[...]}` for every `ExternalInterface.call` of
+//!   skua.swf (its `Externalizer` sends them all as `skuaCall(name, args)`), and `{"ev":"frame"}`
+//!   when a new offscreen frame is written to `--skua-shm`.
+//!
+//! When Bonxie closes the connection the player exits. `--skua-shm <path>` renders offscreen
+//! into a double-buffered shared-memory file instead of mapping a native window (Wayland).
+
+use crate::custom_event::RuffleEvent;
+use memmap2::MmapMut;
+use ruffle_core::context::UpdateContext;
+use ruffle_core::external::{ExternalInterfaceProvider, Value as ExternalValue};
+use serde_json::{Map, Number, Value as Json, json};
+use std::collections::VecDeque;
+use std::fs::{File, OpenOptions};
+use std::io::{BufRead, BufReader, Write};
+use std::net::TcpStream;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, Ordering, fence};
+use std::sync::{Mutex, OnceLock};
+use winit::event_loop::EventLoopProxy;
+
+/// A call from Bonxie, run on the main thread (see `MainWindow::run_skua_calls`).
+pub struct SkuaCall {
+    pub id: u64,
+    pub name: String,
+    pub args: Vec<ExternalValue>,
+}
+
+/// Forwarded UI/game input from Bonxie when running offscreen (`--skua-shm`).
+#[derive(Debug, Clone)]
+pub enum SkuaInput {
+    Resize { width: u32, height: u32 },
+    MouseMove { x: f64, y: f64 },
+    MouseButton { button: String, down: bool },
+    MouseWheel { dx: f64, dy: f64 },
+    Key {
+        down: bool,
+        code: String,
+        key: String,
+        ctrl: bool,
+        shift: bool,
+        alt: bool,
+    },
+    Text { text: String },
+    Focus { focused: bool },
+    Visible { visible: bool },
+    ClearKeys,
+}
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static SHM_ACTIVE: AtomicBool = AtomicBool::new(false);
+static SHM_PATH: OnceLock<PathBuf> = OnceLock::new();
+static SHM_REDRAW_PENDING: AtomicBool = AtomicBool::new(false);
+static WRITER: OnceLock<Mutex<TcpStream>> = OnceLock::new();
+static CALLS: Mutex<VecDeque<SkuaCall>> = Mutex::new(VecDeque::new());
+static INPUTS: Mutex<VecDeque<SkuaInput>> = Mutex::new(VecDeque::new());
+/// Whether a `SkuaWake` is posted or the main thread will look at `CALLS` anyway.
+///
+/// Windows only paints (and winit only reaches `about_to_wait`, where the game ticks) once a
+/// thread's message queue is empty, and every `EventLoopProxy::send_event` is a posted message.
+/// Bonxie calls the game nonstop, so one message per call kept the queue full and froze the game
+/// for up to seconds. Instead at most one wake is posted, and the main thread only asks for the next
+/// one in `about_to_wait`, after the queue (and painting) has run.
+static WAKE_PENDING: AtomicBool = AtomicBool::new(false);
+
+/// Set by `main::mugetsu_args` when started by Bonxie.
+pub fn set_active() {
+    ACTIVE.store(true, Ordering::Relaxed);
+}
+
+pub fn active() -> bool {
+    ACTIVE.load(Ordering::Relaxed)
+}
+
+pub fn init_shm(path: PathBuf) {
+    let _ = SHM_PATH.set(path);
+    SHM_ACTIVE.store(true, Ordering::Relaxed);
+}
+
+pub fn shm_active() -> bool {
+    SHM_ACTIVE.load(Ordering::Relaxed)
+}
+
+pub fn request_shm_redraw() {
+    SHM_REDRAW_PENDING.store(true, Ordering::Release);
+}
+
+pub fn take_shm_redraw() -> bool {
+    SHM_REDRAW_PENDING.swap(false, Ordering::AcqRel)
+}
+
+/// Double-buffered shared-memory frame sink (`[64-byte header][slot 0][slot 1]`).
+pub struct ShmBuffer {
+    file: File,
+    mmap: MmapMut,
+    slot_stride: usize,
+    write_slot: u32,
+    seq: u64,
+}
+
+const SHM_HEADER_SIZE: usize = 64;
+const SHM_MAGIC: &[u8; 8] = b"SKUAFRM1";
+
+impl ShmBuffer {
+    pub fn open_from_cli() -> std::io::Result<Self> {
+        let path = SHM_PATH
+            .get()
+            .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::NotFound, "missing --skua-shm path"))?;
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .open(path)?;
+        let initial_stride = 960 * 550 * 4;
+        file.set_len((SHM_HEADER_SIZE + initial_stride * 2) as u64)?;
+        // SAFETY: only this process writes to the mmap; Bonxie reads only the non-active slot after seq updates.
+        let mut mmap = unsafe { MmapMut::map_mut(&file)? };
+        mmap[0..8].copy_from_slice(SHM_MAGIC);
+        mmap[8..32].fill(0);
+        Ok(Self {
+            file,
+            mmap,
+            slot_stride: initial_stride,
+            write_slot: 0,
+            seq: 0,
+        })
+    }
+
+    pub fn write_frame(
+        &mut self,
+        width: u32,
+        height: u32,
+        padded_bytes_per_row: u32,
+        data: &[u8],
+    ) -> std::io::Result<()> {
+        let row_bytes = (width as usize) * 4;
+        let needed_stride = row_bytes * (height as usize);
+        if needed_stride == 0 {
+            return Ok(());
+        }
+        if needed_stride > self.slot_stride {
+            let new_stride = needed_stride.next_power_of_two().max(needed_stride);
+            self.file
+                .set_len((SHM_HEADER_SIZE + new_stride * 2) as u64)?;
+            // SAFETY: file was resized to hold both slots cleanly.
+            self.mmap = unsafe { MmapMut::map_mut(&self.file)? };
+            self.mmap[0..8].copy_from_slice(SHM_MAGIC);
+            self.slot_stride = new_stride;
+        }
+
+        let slot = self.write_slot;
+        let slot_offset = SHM_HEADER_SIZE + (slot as usize) * self.slot_stride;
+        let dst = &mut self.mmap[slot_offset..slot_offset + needed_stride];
+        let src_stride = padded_bytes_per_row as usize;
+        if src_stride == row_bytes {
+            dst.copy_from_slice(&data[..needed_stride]);
+        } else {
+            for y in 0..(height as usize) {
+                let src_start = y * src_stride;
+                let dst_start = y * row_bytes;
+                dst[dst_start..dst_start + row_bytes]
+                    .copy_from_slice(&data[src_start..src_start + row_bytes]);
+            }
+        }
+
+        self.seq = self.seq.wrapping_add(1);
+        fence(Ordering::Release);
+        self.mmap[8..12].copy_from_slice(&width.to_le_bytes());
+        self.mmap[12..16].copy_from_slice(&height.to_le_bytes());
+        self.mmap[24..28].copy_from_slice(&slot.to_le_bytes());
+        self.mmap[28..32].copy_from_slice(&(self.slot_stride as u32).to_le_bytes());
+        fence(Ordering::Release);
+        self.mmap[16..24].copy_from_slice(&self.seq.to_le_bytes());
+        self.write_slot = 1 - slot;
+
+        notify_frame();
+        Ok(())
+    }
+}
+
+pub fn notify_frame() {
+    send(&json!({ "ev": "frame" }));
+}
+
+/// Connects to Bonxie (once; later movies reuse the connection) and starts reading its calls.
+pub fn connect(addr: &str, event_loop: EventLoopProxy<RuffleEvent>) -> std::io::Result<()> {
+    if WRITER.get().is_some() {
+        return Ok(());
+    }
+
+    #[cfg(target_os = "linux")]
+    {
+        unsafe extern "C" {
+            fn prctl(
+                option: std::os::raw::c_int,
+                arg2: std::os::raw::c_ulong,
+                arg3: std::os::raw::c_ulong,
+                arg4: std::os::raw::c_ulong,
+                arg5: std::os::raw::c_ulong,
+            ) -> std::os::raw::c_int;
+        }
+        unsafe {
+            prctl(1, 9, 0, 0, 0); // PR_SET_PDEATHSIG, SIGKILL
+        }
+    }
+    let stream = TcpStream::connect(addr)?;
+    stream.set_nodelay(true)?;
+    let reader = BufReader::new(stream.try_clone()?);
+    let _ = WRITER.set(Mutex::new(stream));
+
+    std::thread::Builder::new()
+        .name("skua bridge".to_string())
+        .spawn(move || {
+            for line in reader.lines() {
+                let Ok(line) = line else { break };
+                let Ok(msg) = serde_json::from_str::<Json>(&line) else {
+                    tracing::warn!("Skua bridge: bad json {line}");
+                    continue;
+                };
+                if msg.get("input").is_some() {
+                    if let Some(input) = parse_input(&msg) {
+                        lock(&INPUTS).push_back(input);
+                        if !WAKE_PENDING.swap(true, Ordering::AcqRel)
+                            && event_loop.send_event(RuffleEvent::SkuaWake).is_err()
+                        {
+                            return;
+                        }
+                    }
+                } else if let Some(call) = parse_call_json(&msg) {
+                    lock(&CALLS).push_back(call);
+                    if !WAKE_PENDING.swap(true, Ordering::AcqRel)
+                        && event_loop.send_event(RuffleEvent::SkuaWake).is_err()
+                    {
+                        return;
+                    }
+                } else {
+                    tracing::warn!("Skua bridge: bad message {line}");
+                }
+            }
+            tracing::info!("Skua bridge closed, exiting");
+            std::process::exit(0);
+        })?;
+    Ok(())
+}
+
+fn parse_call_json(msg: &Json) -> Option<SkuaCall> {
+    Some(SkuaCall {
+        id: msg.get("id")?.as_u64()?,
+        name: msg.get("name")?.as_str()?.to_string(),
+        args: match msg.get("args") {
+            Some(Json::Array(args)) => args.iter().map(from_json).collect(),
+            _ => Vec::new(),
+        },
+    })
+}
+
+fn parse_input(msg: &Json) -> Option<SkuaInput> {
+    match msg.get("input")?.as_str()? {
+        "resize" => Some(SkuaInput::Resize {
+            width: msg.get("w")?.as_u64()? as u32,
+            height: msg.get("h")?.as_u64()? as u32,
+        }),
+        "mouse_move" => Some(SkuaInput::MouseMove {
+            x: msg.get("x")?.as_f64()?,
+            y: msg.get("y")?.as_f64()?,
+        }),
+        "mouse_btn" => Some(SkuaInput::MouseButton {
+            button: msg.get("button")?.as_str()?.to_string(),
+            down: msg.get("down")?.as_bool()?,
+        }),
+        "mouse_wheel" => Some(SkuaInput::MouseWheel {
+            dx: msg.get("dx").and_then(|v| v.as_f64()).unwrap_or(0.0),
+            dy: msg.get("dy").and_then(|v| v.as_f64()).unwrap_or(0.0),
+        }),
+        "key" => Some(SkuaInput::Key {
+            down: msg.get("down")?.as_bool()?,
+            code: msg.get("code")?.as_str()?.to_string(),
+            key: msg.get("key")?.as_str()?.to_string(),
+            ctrl: msg.get("ctrl").and_then(|v| v.as_bool()).unwrap_or(false),
+            shift: msg.get("shift").and_then(|v| v.as_bool()).unwrap_or(false),
+            alt: msg.get("alt").and_then(|v| v.as_bool()).unwrap_or(false),
+        }),
+        "text" => Some(SkuaInput::Text {
+            text: msg.get("text")?.as_str()?.to_string(),
+        }),
+        "focus" => Some(SkuaInput::Focus {
+            focused: msg.get("focused")?.as_bool()?,
+        }),
+        "visible" => Some(SkuaInput::Visible {
+            visible: msg.get("visible")?.as_bool()?,
+        }),
+        "clear_keys" => Some(SkuaInput::ClearKeys),
+        _ => None,
+    }
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+/// The calls received so far, for the main thread to run.
+pub fn take_calls() -> VecDeque<SkuaCall> {
+    std::mem::take(&mut *lock(&CALLS))
+}
+
+/// The forwarded input events received so far, for the main thread to run.
+pub fn take_inputs() -> VecDeque<SkuaInput> {
+    std::mem::take(&mut *lock(&INPUTS))
+}
+
+/// Called from `about_to_wait`: calls arriving from now on post a new wake.
+pub fn rearm() {
+    WAKE_PENDING.store(false, Ordering::Release);
+}
+
+pub fn reply(id: u64, result: ExternalValue) {
+    send(&json!({ "id": id, "r": to_json(&result) }));
+}
+
+fn send(msg: &Json) {
+    if let Some(writer) = WRITER.get() {
+        // One write per message: formatting straight into the socket made a send() (and, with
+        // nodelay, a packet) per JSON token, so a big reply held up the game for seconds.
+        if let Err(error) = lock(writer).write_all(format!("{msg}\n").as_bytes()) {
+            tracing::warn!("Skua bridge: send failed: {error}");
+        }
+    }
+}
+
+fn to_json(value: &ExternalValue) -> Json {
+    match value {
+        ExternalValue::Undefined | ExternalValue::Null => Json::Null,
+        ExternalValue::Bool(b) => Json::Bool(*b),
+        // Whole numbers as integers, the way Flash's ExternalInterface printed them.
+        ExternalValue::Number(n) if n.fract() == 0.0 && n.abs() < 9.0e15 => Json::from(*n as i64),
+        ExternalValue::Number(n) => Number::from_f64(*n).map_or(Json::Null, Json::Number),
+        ExternalValue::String(s) => Json::String(s.clone()),
+        ExternalValue::List(list) => Json::Array(list.iter().map(to_json).collect()),
+        ExternalValue::Object(map) => Json::Object(
+            map.iter()
+                .map(|(key, value)| (key.clone(), to_json(value)))
+                .collect::<Map<_, _>>(),
+        ),
+    }
+}
+
+fn from_json(value: &Json) -> ExternalValue {
+    match value {
+        Json::Null => ExternalValue::Null,
+        Json::Bool(b) => ExternalValue::Bool(*b),
+        Json::Number(n) => ExternalValue::Number(n.as_f64().unwrap_or_default()),
+        Json::String(s) => ExternalValue::String(s.clone()),
+        Json::Array(list) => ExternalValue::List(list.iter().map(from_json).collect()),
+        Json::Object(map) => ExternalValue::Object(
+            map.iter()
+                .map(|(key, value)| (key.clone(), from_json(value)))
+                .collect(),
+        ),
+    }
+}
+
+/// skua.swf's `ExternalInterface.call`s, forwarded to Bonxie as events.
+pub struct SkuaExternalInterface;
+
+impl ExternalInterfaceProvider for SkuaExternalInterface {
+    fn call_method(
+        &self,
+        _context: &mut UpdateContext<'_>,
+        name: &str,
+        args: &[ExternalValue],
+    ) -> ExternalValue {
+        match (name, args) {
+            ("skuaCall", [ExternalValue::String(event), rest @ ..]) => {
+                let args = match rest.first() {
+                    Some(ExternalValue::List(list)) => list.iter().map(to_json).collect(),
+                    _ => Vec::new(),
+                };
+                send(&json!({ "ev": event, "args": args }));
+            }
+            _ => tracing::warn!("Skua bridge: unknown ExternalInterface call {name}"),
+        }
+        ExternalValue::Undefined
+    }
+
+    fn on_callback_available(&self, _name: &str) {}
+
+    fn get_id(&self) -> Option<String> {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn json_round_trip() {
+        let value = ExternalValue::List(vec![
+            ExternalValue::Number(5.0),
+            ExternalValue::Number(1.5),
+            ExternalValue::String("a\"b".into()),
+            ExternalValue::Bool(true),
+            ExternalValue::Null,
+        ]);
+        let json = to_json(&value);
+        assert_eq!(json.to_string(), r#"[5,1.5,"a\"b",true,null]"#);
+        assert_eq!(from_json(&json), value);
+    }
+
+    #[test]
+    fn parses_calls() {
+        let msg: Json = serde_json::from_str(r#"{"id":7,"name":"getGameObject","args":["world.myAvatar"]}"#).unwrap();
+        let call = parse_call_json(&msg).expect("valid call");
+        assert_eq!((call.id, call.name.as_str()), (7, "getGameObject"));
+        assert_eq!(call.args, vec![ExternalValue::String("world.myAvatar".into())]);
+    }
+}
