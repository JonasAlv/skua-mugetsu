+struct ShmRenderState {
+    target_texture: wgpu::Texture,
+    staging_buffers: [wgpu::Buffer; 2],
+    active_staging: usize,
+    pending_readback: Option<(usize, u32, u32, u32)>,
+    map_status: std::sync::Arc<std::sync::atomic::AtomicU8>,
+    width: u32,
+    height: u32,
+    padded_bytes_per_row: u32,
+    buffer: crate::skua::ShmBuffer,
+}
+
+impl ShmRenderState {
+    fn new(device: &wgpu::Device, width: u32, height: u32) -> anyhow::Result<Self> {
+        let buffer = crate::skua::ShmBuffer::open_from_cli()?;
+        let (target_texture, staging_buffers, padded_bytes_per_row) =
+            Self::create_gpu_resources(device, width, height);
+        Ok(Self {
+            target_texture,
+            staging_buffers,
+            active_staging: 0,
+            pending_readback: None,
+            map_status: std::sync::Arc::new(std::sync::atomic::AtomicU8::new(0)),
+            width,
+            height,
+            padded_bytes_per_row,
+            buffer,
+        })
+    }
+
+    fn create_gpu_resources(
+        device: &wgpu::Device,
+        width: u32,
+        height: u32,
+    ) -> (wgpu::Texture, [wgpu::Buffer; 2], u32) {
+        let w = width.max(1);
+        let h = height.max(1);
+        let target_texture = device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("skua shm target"),
+            size: wgpu::Extent3d {
+                width: w,
+                height: h,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Bgra8Unorm,
+            usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+            view_formats: &[],
+        });
+        let align = wgpu::COPY_BYTES_PER_ROW_ALIGNMENT;
+        let unpadded = w * 4;
+        let padded_bytes_per_row = unpadded.div_ceil(align) * align;
+        let buf_desc = wgpu::BufferDescriptor {
+            label: Some("skua shm staging"),
+            size: (padded_bytes_per_row as u64) * (h as u64),
+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        };
+        let staging_0 = device.create_buffer(&buf_desc);
+        let staging_1 = device.create_buffer(&buf_desc);
+        (target_texture, [staging_0, staging_1], padded_bytes_per_row)
+    }
+
+    fn begin_readback(&mut self, idx: usize, width: u32, height: u32, padded: u32) {
+        self.map_status.store(0, std::sync::atomic::Ordering::Release);
+        let status = self.map_status.clone();
+        self.staging_buffers[idx].slice(..).map_async(wgpu::MapMode::Read, move |res| {
+            status.store(
+                if res.is_ok() { 1 } else { 2 },
+                std::sync::atomic::Ordering::Release,
+            );
+        });
+        self.pending_readback = Some((idx, width, height, padded));
+    }
+
+    fn try_flush_pending(&mut self, device: &wgpu::Device) {
+        self.poll_readback(device, false);
+    }
+
+    fn flush_pending(&mut self, device: &wgpu::Device) {
+        self.poll_readback(device, true);
+    }
+
+    fn poll_readback(&mut self, device: &wgpu::Device, block: bool) {
+        let Some((idx, width, height, padded)) = self.pending_readback else {
+            return;
+        };
+        let poll_type = if block {
+            wgpu::PollType::wait_indefinitely()
+        } else {
+            wgpu::PollType::Poll
+        };
+        let _ = device.poll(poll_type);
+        let status = self.map_status.load(std::sync::atomic::Ordering::Acquire);
+        if status == 0 {
+            return;
+        }
+        self.pending_readback = None;
+        let staging = &self.staging_buffers[idx];
+        if status == 1 {
+            let slice = staging.slice(..);
+            if let Ok(data) = slice.get_mapped_range() {
+                if let Err(err) = self.buffer.write_frame(width, height, padded, &data) {
+                    tracing::warn!("Skua shm write failed: {err}");
+                }
+                drop(data);
+            }
+            staging.unmap();
+        }
+    }
+
+    fn ensure_size(&mut self, device: &wgpu::Device, width: u32, height: u32) {
+        let w = width.max(1);
+        let h = height.max(1);
+        if self.width != w || self.height != h {
+            self.flush_pending(device);
+            let (tex, bufs, padded) = Self::create_gpu_resources(device, w, h);
+            self.target_texture = tex;
+            self.staging_buffers = bufs;
+            self.active_staging = 0;
+            self.width = w;
+            self.height = h;
+            self.padded_bytes_per_row = padded;
+        }
+    }
+}
